// Soong build for the FDE SystemUI plugin. The Gradle build (see build.gradle,
// app/build.gradle) keeps working on its own and is not affected by this file.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ---------------------------------------------------------------------------
// Third-party libraries that are not available as Soong modules in the AOSP
// tree. These are the exact artifacts used by the Gradle build.
// ---------------------------------------------------------------------------

android_library_import {
    name: "bdsystemui-glide",
    aars: ["prebuilts/glide-4.12.0.aar"],
}

java_import {
    name: "bdsystemui-glide-annotations",
    jars: ["prebuilts/glide-annotations-4.12.0.jar"],
}

java_import {
    name: "bdsystemui-glide-disklrucache",
    jars: ["prebuilts/glide-disklrucache-4.12.0.jar"],
}

android_library_import {
    name: "bdsystemui-glide-gifdecoder",
    aars: ["prebuilts/glide-gifdecoder-4.12.0.aar"],
}

java_import {
    name: "bdsystemui-androidsvg",
    jars: ["prebuilts/androidsvg-1.4.jar"],
}

android_library_import {
    name: "bdsystemui-magicindicator",
    aars: ["prebuilts/MagicIndicator-1.7.0.aar"],
}

android_library_import {
    name: "bdsystemui-okhttputils",
    aars: ["prebuilts/okHttpUtils-1.3.0.aar"],
}

java_import {
    name: "bdsystemui-okhttp",
    jars: ["prebuilts/okhttp-3.5.0.jar"],
}

java_import {
    name: "bdsystemui-okio",
    jars: ["prebuilts/okio-1.11.0.jar"],
}

java_import {
    name: "bdsystemui-pinyin4j",
    jars: ["prebuilts/pinyin4j-2.5.1.jar"],
}

android_library_import {
    name: "bdsystemui-viewpager",
    aars: ["prebuilts/viewpager-1.0.0.aar"],
}

// ---------------------------------------------------------------------------
// FdeSystemUI: the FDE/Boringdroid SystemUI overlay plugin.
// Replaces the prebuilt BoringdroidSystemUI.apk (module FdeSystemUI) that the
// device tree used to install.
// ---------------------------------------------------------------------------

android_app {
    name: "FdeSystemUI",
    package_name: "com.boringdroid.systemui",

    srcs: [
        "app/src/main/java/**/*.java",
        "app/src/main/java/**/*.kt",
        "app/src/main/aidl/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["app/src/main/aidl"],
    },

    manifest: "app/src/main/AndroidManifest.xml",
    // app/src/main/SystemUISharedRes is only used by the Gradle build. Its
    // content (SystemUI shared attrs) is provided by SystemUISharedLib here,
    // including both dirs would define the same attrs twice.
    resource_dirs: ["app/src/main/res"],

    static_libs: [
        // SystemUI shared library: plugin API, plugin core, Kotlin stdlib...
        "SystemUISharedLib",

        // AndroidX/Material dependencies that exist as Soong modules
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.core_core-ktx",
        "androidx.fragment_fragment",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "androidx.room_room-runtime",
        "androidx.sqlite_sqlite",
        "androidx-constraintlayout_constraintlayout",
        "com.google.android.material_material",
        "kotlinx_coroutines",
        "kotlinx_coroutines_android",
        "gson",

        // Prebuilt third-party libraries (see above)
        "bdsystemui-glide",
        "bdsystemui-glide-annotations",
        "bdsystemui-glide-disklrucache",
        "bdsystemui-glide-gifdecoder",
        "bdsystemui-androidsvg",
        "bdsystemui-magicindicator",
        "bdsystemui-okhttputils",
        "bdsystemui-okhttp",
        "bdsystemui-okio",
        "bdsystemui-pinyin4j",
        "bdsystemui-viewpager",
    ],
    // Room annotation processing (kapt for Kotlin, javac for Java)
    plugins: ["androidx.room_room-compiler-plugin"],

    platform_apis: true,
    min_sdk_version: "current",
    target_sdk_version: "current",

    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    // Keep the version information of the Gradle build.
    aaptflags: [
        "--version-code",
        "154",
        "--version-name",
        "1.5.4",
    ],

    optimize: {
        enabled: false,
    },
}
