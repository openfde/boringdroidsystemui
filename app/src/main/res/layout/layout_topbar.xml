<?xml version="1.0" encoding="utf-8"?>
<com.boringdroid.systemui.view.TopBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_blur"
    android:layout_height="@dimen/top_bar_layout_height"
    android:layout_width="@dimen/top_bar_layout_width"
    android:gravity="center_vertical"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:background="#30FFFFFF"
        android:layout_marginBottom="1dp"
        >
        <TextClock
            android:layout_marginLeft="12dp"
            android:id="@+id/date_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:format12Hour="MM/dd hh:mm a"
            android:format24Hour="MM/dd HH:mm"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            style="@style/style_35"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            >
            <ImageView
                android:id="@+id/imeswitch_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/input_delete"
                android:layout_toLeftOf="@id/wifi_btn"
                />

            <ImageView
                android:id="@+id/wifi_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_wifi_unselect_full"
                />

            <ImageView
                android:id="@+id/volume_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_volume_top_max"
                />

            <ImageView
                android:id="@+id/battery_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_battery_chargeing_100"
                />
            <ImageView
                android:id="@+id/search_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_search"
                />
            <ImageView
                android:id="@+id/control_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:scaleType="fitXY"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_control"
                />

            <ImageView
                android:id="@+id/notifications_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:scaleType="fitXY"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_notification_red"
                />
            <ImageView
                android:id="@+id/about_btn"
                android:layout_width="@dimen/topbar_icon_size"
                android:layout_height="@dimen/topbar_icon_size"
                android:padding="@dimen/topbar_icon_padding"
                android:src="@drawable/icon_power"
                />

            <LinearLayout
                android:id="@+id/desktop_btn"
                android:layout_width="14dp"
                android:layout_height="24dp">
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#1a000000"/>
            </LinearLayout>


        </LinearLayout>
    </RelativeLayout>
</com.boringdroid.systemui.view.TopBarLayout>

