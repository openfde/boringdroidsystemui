<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="@dimen/top_bar_search_width"
        android:layout_height="@dimen/top_bar_search_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/round_rect_12dp_bf"
        >

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginVertical="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/icon_search"
            />

        <EditText
            android:id="@+id/search_global_et"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:textColorHint="#4d292929"
            style="@style/style_55"
            android:textSize="22sp"
            android:hint="@string/global_search"
            />

    </LinearLayout>
    
    <TextView
        android:id="@+id/empty_tv"
        android:layout_width="@dimen/top_bar_search_width"
        android:layout_height="160dp"
        android:background="@drawable/round_rect_12dp_bf"
        android:textColor="#73000000"
        style="@style/style_55"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:text="@string/no_matching_item"
        android:visibility="gone"
        />

    <ScrollView
        android:id="@+id/search_result_sv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/round_rect_12dp_bf"
        android:scrollbarStyle="insideInset"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        >
        <LinearLayout
            android:id="@+id/search_app_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >
                <TextView
                    android:gravity="center_vertical"
                    style="@style/style_55"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/application"
                    android:paddingLeft="8dp"
                    android:textColor="#94262626"
                    android:textStyle="bold"
                    />
                <ImageView
                    android:id="@+id/expand_app_iv"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="7dp"
                    android:src="@drawable/icon_down"
                    android:layout_marginLeft="7dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    />
            </RelativeLayout>
            <com.boringdroid.systemui.view.LoadedSearchRecycleView
                android:id="@+id/search_app_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </LinearLayout>
    </ScrollView>
</LinearLayout>