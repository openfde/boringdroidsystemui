<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    >

    <com.boringdroid.systemui.view.LoadedCardView
        android:id="@+id/root_blur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="4dp"
        app:cardElevation="6dp"
        >

        <RelativeLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_rect_10dp_bf"
            android:paddingBottom="10dp"
            >
            <ImageView
                android:id="@+id/image_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/icon_all_apps"
                />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_toRightOf="@id/image_icon"
                android:text=""
                android:textSize="14sp"
                android:textColor="#73000000"
                android:layout_marginTop="13dp"
                style="@style/style_55"
                />
            <TextView
                android:id="@+id/tv_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="12dp"
                android:textSize="14sp"
                android:text="刚刚"
                android:textColor="#73000000"
                android:layout_alignParentRight="true"
                style="@style/style_55"
                />
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:text=""
                android:maxLength="22"
                android:textColor="#E6000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginLeft="44dp"
                style="@style/style_55"
                />
            <TextView
                android:id="@+id/tv_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:maxWidth="312dp"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:text=""
                android:textColor="#E6000000"
                android:textSize="14sp"
                android:layout_below="@id/tv_title"
                style="@style/style_55"
                />
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:padding="6dp"
                android:src="@drawable/icon_close"
                android:layout_alignParentRight="true"
                android:background="@drawable/gray_circle"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                />

            <LinearLayout
                android:id="@+id/notification_actions_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/tv_content"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_below="@id/tv_title"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </RelativeLayout>

    </com.boringdroid.systemui.view.LoadedCardView>
</RelativeLayout>