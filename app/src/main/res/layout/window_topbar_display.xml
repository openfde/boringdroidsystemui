<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/top_bar_display_width_expand"
    android:layout_height="match_parent"
    android:gravity="right"
    android:orientation="vertical">

    <com.boringdroid.systemui.view.LoadedCardView
        android:id="@+id/root_blur"
        android:layout_width="@dimen/top_bar_display_width"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_rect_16dp_control"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/external_display_title"
                android:textColor="#ff292929"
                android:textSize="16sp"
                android:textStyle="bold"
                style="@style/style_55" />

            <LinearLayout
                android:id="@+id/display_toggle_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/display_toggle_iv"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_display_toggle"
                    android:clickable="true"
                    android:contentDescription="@string/external_display_toggle"
                    android:focusable="true"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_external_display" />

                <TextView
                    android:id="@+id/display_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/external_display_toggle"
                    android:textColor="#ff1d1d1f"
                    android:textSize="12sp"
                    style="@style/style_55" />

                <TextView
                    android:id="@+id/display_state_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/external_display_state_off"
                    android:textColor="#8c000000"
                    android:textSize="11sp"
                    style="@style/style_55" />

                <TextView
                    android:id="@+id/display_reason_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="240dp"
                    android:text="@string/external_display_service_unavailable"
                    android:textColor="#66000000"
                    android:textSize="11sp"
                    android:visibility="gone"
                    style="@style/style_55" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0d000000" />

            <TextView
                android:id="@+id/display_settings_tv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_display_settings"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="@string/external_display_settings"
                android:textColor="#d9000000"
                android:textSize="13sp"
                style="@style/style_55" />
        </LinearLayout>
    </com.boringdroid.systemui.view.LoadedCardView>
</LinearLayout>
