<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/top_bar_control_width_expand"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="right">

    <com.boringdroid.systemui.view.LoadedCardView
        android:id="@+id/root_blur"
        android:layout_width="@dimen/top_bar_control_width"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        android:layout_margin="8dp"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:background="@drawable/round_rect_16dp_control"
            >
            <TextView
                android:id="@+id/shortcut_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="16dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:textColor="#ff292929"
                android:textSize="16sp"
                android:textStyle="bold"
                style="@style/style_55"
                android:text="快捷控制" />

            <LinearLayout
                android:layout_below="@id/shortcut_tv"
                android:id="@+id/wifi_cv"
                android:layout_width="166dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/round_rect_12dp_top"
                android:elevation="@dimen/elevation_control_panel"
                >
                <ImageView
                    android:id="@+id/wifi_img"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical"
                    android:padding="10dp"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/icon_wifi_select_full"
                    android:background="@drawable/control_oval_blue"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="6dp"
                    android:layout_marginBottom="15dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_marginTop="17dp"
                        android:layout_centerVertical="true"
                        android:textColor="#ff262626"
                        android:textSize="14sp"
                        android:text="无线网络"
                        style="@style/style_55"
                        />

                    <TextView
                        android:id="@+id/tv_wifi_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:textColor="#59000000"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:text="未开启"
                        style="@style/style_55"
                        />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_below="@id/shortcut_tv"
                android:layout_width="166dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_marginTop="15dp"
                android:layout_alignParentRight="true"
                android:background="@drawable/round_rect_12dp_top"
                android:elevation="@dimen/elevation_control_panel"
                >
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/icon_light_unselect"
                    android:padding="10dp"
                    android:background="@drawable/control_oval_gray"
                    />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="6dp"
                    android:layout_marginBottom="15dp"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_marginTop="17dp"
                        android:layout_centerVertical="true"
                        android:textColor="#ff262626"
                        android:textSize="14sp"
                        android:text="夜间模式"
                        style="@style/style_55"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:textColor="#59000000"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"
                        android:text="未开启"
                        style="@style/style_55"
                        />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/control_ll"
                android:layout_below="@+id/wifi_cv"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/round_rect_12dp_top"
                android:elevation="@dimen/elevation_control_panel"
                android:paddingBottom="15dp"
                >
                <FrameLayout
                    android:layout_width="@dimen/control_item_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginLeft="18dp"
                    >
                    <ImageView
                        android:id="@+id/screenshot_iv"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="14dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/icon_fullscreen_shot_unselect"
                        android:background="@drawable/control_oval_bg_26"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="64dp"
                        android:gravity="center"
                        android:textColor="#ff292929"
                        android:layout_gravity="center_horizontal"
                        android:textSize="13sp"
                        android:alpha="1"
                        android:text="@string/printscreen_string"
                        style="@style/style_55"
                        />

                </FrameLayout>
                <FrameLayout
                    android:layout_width="@dimen/control_item_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginLeft="12dp"
                    >
                    <ImageView
                        android:id="@+id/regionshot_iv"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:padding="14dp"
                        android:src="@drawable/icon_regionshot_unselect"
                        android:background="@drawable/control_oval_bg_26"
                        />

                    <TextView
                        style="@style/style_55"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="64dp"
                        android:alpha="1"
                        android:gravity="center"
                        android:breakStrategy="balanced"
                        android:justificationMode="inter_word"
                        android:text="@string/printscreen_region_string"
                        android:textColor="#ff292929"
                        android:textSize="13sp" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="@dimen/control_item_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginLeft="12dp"
                    >
                    <ImageView
                        android:id="@+id/record_iv"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:padding="14dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/icon_record_unselect"
                        android:background="@drawable/control_oval_bg_26"
                        />
                    <TextView
                        android:id="@+id/record_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="64dp"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:textColor="#ff292929"
                        android:textSize="13sp"
                        android:alpha="1"
                        android:text="@string/recordscreen_string"
                        style="@style/style_55"
                        />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="@dimen/control_item_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="22dp"
                    android:layout_marginLeft="12dp"
                    >
                    <ImageView
                        android:id="@+id/setting_iv"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:padding="14dp"
                        android:src="@drawable/icon_setting_unselect"
                        android:background="@drawable/control_oval_bg_26"
                        />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="64dp"
                        android:gravity="center"
                        android:textColor="#ff292929"
                        android:textSize="13sp"
                        android:alpha="1"
                        android:text="@string/setting_string"
                        style="@style/style_55"
                        />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/volume_ll"
                android:layout_below="@+id/control_ll"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:background="@drawable/round_rect_12dp_top"
                android:elevation="@dimen/elevation_control_panel"
                >

                <ImageView
                    android:id="@+id/volume_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="1dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/icon_volume_max"
                    />

                <SeekBar
                    android:id="@+id/volume_seekbar"
                    android:layout_width="262dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="8dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:splitTrack="false"
                    android:thumb="@drawable/sb_thumb"
                    />
                <ImageView
                    android:id="@+id/volume_go_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="3dp"
                    android:src="@drawable/icon_right_arrow"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_below="@+id/volume_ll"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/round_rect_12dp_top"
                android:elevation="@dimen/elevation_control_panel"
                android:gravity="center_vertical"
                >
                <ImageView
                    android:id="@+id/brightness_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="1dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/icon_brightness"
                    />

                <SeekBar
                    android:id="@+id/brightness_seekbar"
                    android:layout_width="262dp"
                    android:layout_height="15dp"
                    android:layout_marginLeft="8dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:splitTrack="false"
                    android:thumb="@drawable/sb_thumb"
                    />
            </LinearLayout>

        </RelativeLayout>
    </com.boringdroid.systemui.view.LoadedCardView>
</RelativeLayout>