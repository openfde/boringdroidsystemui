<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_ll"
    android:layout_marginHorizontal="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/action_tv"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="@string/minimize"
        style="@style/style_55"
        />

</LinearLayout>