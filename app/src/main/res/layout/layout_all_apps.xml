<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fde_bg"
    >

    <RelativeLayout
        android:layout_width="40dp"
        android:id="@+id/layoutLeft"
        android:layout_alignParentLeft="true"
        android:paddingBottom="8dp"
        android:background="@color/fde_bg"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgPower"
            android:layout_width="@dimen/wifi_status_window_height"
            android:src="@drawable/power"
            android:padding="@dimen/fde_left_setting_padding_size"
            android:layout_alignParentBottom="true"
            android:layout_height="@dimen/wifi_status_window_height"/>


        <ImageView
            android:id="@+id/imgSetting"
            android:layout_above="@id/imgPower"
            android:layout_width="@dimen/wifi_status_window_height"
            android:src="@drawable/icon_settings"
            android:padding="@dimen/fde_left_setting_padding_size"
            android:layout_height="@dimen/wifi_status_window_height"/>

    </RelativeLayout>

    <View
        android:id="@+id/viewLine1"
        android:layout_width="1dp"
        android:background="#000"
        android:alpha="0.06"
        android:layout_toRightOf="@id/layoutLeft"
        android:layout_height="match_parent"/>

    <EditText
        android:imeOptions="actionGo"
        android:layout_toRightOf="@id/viewLine1"
        android:textColorHint="@android:color/darker_gray"
        android:hint="@string/fde_search"
        android:textColor="#222222"
        android:layout_height="36dp"
        android:layout_width="268dp"
        android:paddingHorizontal="5dp"
        android:maxLength="18"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        android:layout_gravity="center_vertical"
        android:drawablePadding="4dp"
        android:drawableLeft="@drawable/icon_search"
        android:background="@drawable/search_text_background"
        android:id="@+id/search_et"
        android:textSize="17sp"
        android:singleLine="true"/>

    <LinearLayout
        android:id="@+id/relative_all_apps"
        android:layout_toRightOf="@id/viewLine1"
        android:background="@color/fde_bg"
        android:layout_width="300dp"
        android:orientation="vertical"
        android:layout_below="@id/search_et"
        android:layout_height="match_parent"
        />

    <View
        android:layout_toRightOf="@id/relative_all_apps"
        android:layout_width="1dp"
        android:background="#000"
        android:alpha="0.06"
        android:id="@+id/viewLine2"
        android:layout_height="match_parent"/>


    <TextView
        android:text="@string/fde_collect"
        android:layout_width="wrap_content"
        android:textSize="16sp"
        android:id="@+id/relative_collect_title"
        android:textColor="#333"
        android:textStyle="bold"
        android:layout_margin="12dp"
        android:layout_toRightOf="@id/viewLine2"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/relative_collect_apps"
        android:layout_toRightOf="@id/viewLine2"
        android:background="@color/fde_bg"
        android:layout_below="@id/relative_collect_title"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        />

</RelativeLayout>