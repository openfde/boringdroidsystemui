<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="@dimen/volume_window_width_expand"
    android:layout_height="@dimen/volume_window_height_expand"
    android:gravity="right"
    >


    <com.boringdroid.systemui.view.LoadedCardView
        android:id="@+id/root_blur"
        android:layout_width="@dimen/volume_window_width"
        android:layout_height="@dimen/volume_window_height"
        android:layout_margin="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="5dp"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/round_rect_12dp_about"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="20dp"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:textColor="#ff262626"
                android:textSize="16sp"
                android:text="@string/sound"
                style="@style/style_55"
                android:textStyle="bold"
                />
            <LinearLayout
                android:layout_marginTop="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                >

                <ImageView
                    android:id="@+id/volume_iv"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="1dp"
                    android:src="@drawable/icon_volume_max"
                    />

                <SeekBar
                    android:id="@+id/volume_seekbar"
                    android:layout_width="262dp"
                    android:layout_height="18dp"
                    android:layout_marginLeft="11dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:splitTrack="false"
                    android:thumb="@drawable/sb_thumb"
                    />
                <TextView
                    android:id="@+id/volume_tv"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="#d9000000"
                    android:textSize="18sp"
                    android:gravity="left|center_vertical"
                    android:paddingBottom="3dp"
                    android:text="0"
                    />

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0d000000"
                android:layout_marginTop="91dp"
                />

            <LinearLayout
                android:layout_width="336dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="106dp"
                android:orientation="horizontal"
                android:id="@+id/device_ll"
                android:background="@drawable/round_rect_6dp_0a"
                android:gravity="center_vertical"
                android:paddingHorizontal="3dp"
                android:paddingVertical="3dp"
                >

                <Button
                    android:id="@+id/out_bt"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="164dp"
                    android:layout_height="32dp"
                    android:background="@drawable/round_rect_4dp_ff"
                    android:gravity="center"
                    android:text="@string/set_output"
                    android:textColor="#ff292929"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/in_bt"
                    android:layout_width="164dp"
                    android:layout_height="32dp"
                    style="?android:attr/buttonBarStyle"
                    android:textColor="#ff292929"
                    android:textSize="14sp"
                    android:text="@string/set_input"
                    />
            </LinearLayout>

            <com.boringdroid.systemui.view.LoadedSoundRecycleView
                android:id="@+id/in_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="60dp"
                android:layout_marginHorizontal="14dp"
                android:layout_below="@+id/device_ll"
                android:visibility="gone"
                />

            <com.boringdroid.systemui.view.LoadedSoundRecycleView
                android:id="@+id/out_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="60dp"
                android:layout_marginHorizontal="14dp"
                android:layout_below="@+id/device_ll"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0d000000"
                android:layout_marginTop="412dp"
                />

            <TextView
                android:id="@+id/more_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="21dp"
                android:textColor="#ff292929"
                android:textSize="14sp"
                android:text="@string/sound_more_set"
                style="@style/style_55"
                android:textFontWeight="400"
                android:layout_marginBottom="14dp"
                />
        </RelativeLayout>

    </com.boringdroid.systemui.view.LoadedCardView>
</LinearLayout>