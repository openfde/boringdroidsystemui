<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="@dimen/top_bar_power_width"
    android:layout_height="@dimen/top_bar_power_height"
    android:background="#c7FFFFFF">

    <TextView
        android:id="@+id/about_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_marginTop="5dp"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="关于本机"
        />
    <TextView
        android:id="@+id/setting_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="系统设置"
        />
    
    <View
        android:layout_marginVertical="5dp"
        android:layout_width="130dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="10dp"
        android:background="#1a000000"
        />

    <TextView
        android:id="@+id/sleep_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="睡眠"
        />

    <TextView
        android:id="@+id/shutdown_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="关机"
        />
    <TextView
        android:id="@+id/reboot_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="重启"
        />
    <View
        android:layout_marginVertical="5dp"
        android:layout_width="130dp"
        android:layout_height="1dp"
        android:layout_marginHorizontal="10dp"
        android:background="#1a000000"
        />
    <TextView
        android:id="@+id/logout_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="注销"
        />
    <TextView
        android:id="@+id/lock_tv"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentLeft="true"
        android:layout_marginHorizontal="@dimen/top_text_margin"
        android:paddingHorizontal="@dimen/top_text_padding"
        android:layout_centerVertical="true"
        android:textColor="#e6000000"
        android:textSize="14sp"
        android:lineSpacingExtra="5.2sp"
        android:gravity="left|center_vertical"
        android:text="锁屏"
        />



</LinearLayout>